#!/usr/bin/env python3
import json
import os
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


def text_of(msg):
    c = msg.get("content") or ""
    if isinstance(c, list):
        c = "".join(p.get("text", "") for p in c if isinstance(p, dict))
    if c.startswith("<chat>") and "</chat>\n" in c:
        c = c.split("</chat>\n", 1)[1]
    return c


def chunk(delta):
    return "data: " + json.dumps({"choices": [{"delta": delta}]}) + "\n\n"


def tool_call(name, args):
    fn = {"name": name, "arguments": json.dumps(args)}
    return chunk({"tool_calls": [{"index": 0, "id": "call_1", "function": fn}]})


def reply(msgs):
    system = text_of(msgs[0]) if msgs and msgs[0].get("role") == "system" else ""
    last = msgs[-1] if msgs else {}
    content = text_of(last)
    if system.startswith("You write the memory"):
        if "slowcompact" in content:
            time.sleep(3)
        return chunk({"content": "summary"})
    if "status update on what the agent" in content:
        saw = "tool call: bash sleep 9" in content and "run: sleep 9" in content
        return chunk({"content": "status: " + ("sees the turn" if saw else "blind")})
    if last.get("role") == "tool":
        return chunk({"content": "tool said: " + content[:200]})
    if content.startswith("spawnin: "):
        cwd, task = content[9:].split(" ", 1)
        return tool_call("agent", {"task": task, "cwd": cwd})
    if content.startswith("spawn: "):
        return tool_call("agent", {"task": content[7:]})
    if content.startswith("run: "):
        return tool_call("bash", {"command": content[5:]})
    return chunk({"content": "echo: " + content[:200]})


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        msgs = body.get("messages", [])
        out = reply(msgs)
        usage = {"prompt_tokens": 100, "completion_tokens": 5}
        if msgs and "cachestats" in text_of(msgs[-1]):
            usage = {"prompt_tokens": 10000, "completion_tokens": 5,
                     "prompt_tokens_details": {"cached_tokens": 9000, "cache_write_tokens": 500}}
        out += "data: " + json.dumps({"choices": [], "usage": usage}) + "\n\n"
        out += "data: [DONE]\n\n"
        data = out.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *args):
        pass


def watch(path):
    while os.path.exists(path):
        time.sleep(1)
    os._exit(0)


server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
with open(sys.argv[1], "w") as f:
    f.write(str(server.server_address[1]))
threading.Thread(target=watch, args=(sys.argv[1],), daemon=True).start()
server.serve_forever()
