#!/usr/bin/env bash
real=$(command -v tailscale || echo /Applications/Tailscale.app/Contents/MacOS/Tailscale)
[ -x /usr/local/bin/tailscale ] && real=/usr/local/bin/tailscale
[ -x /opt/homebrew/bin/tailscale ] && real=/opt/homebrew/bin/tailscale
if [ "$1" = status ]; then
    "$real" status --json | python3 -c '
import json, sys
st = json.load(sys.stdin)
st.setdefault("Peer", {})["blackhole"] = {"DNSName": "blackhole.example.ts.net.", "HostName": "blackhole",
    "TailscaleIPs": ["100.64.255.254"], "UserID": st["Self"]["UserID"], "Online": True, "OS": "linux"}
print(json.dumps(st))'
else
    exec "$real" "$@"
fi
