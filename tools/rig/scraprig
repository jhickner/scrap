#!/usr/bin/env bash
set -euo pipefail

RIG_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${SCRAPRIG_ROOT:-/tmp/scraprig}"

usage() {
    cat >&2 <<'EOF'
usage: scraprig <command> ...

  start  [-n name] [-s COLSxROWS] [--fake] [--openai] [--fixture file] [--share dir] [--net [--port N]]
         [--scrap path] [-- scrap args]
         start scrap; prints the instance name. --share dir: instances started
         with the same dir share live sessions, dispatch, chains, and
         net config. --net: the instance's scrap hub broker listens on the
         tailscale address at port N (default random; with --share, the first
         instance picks it); without it no broker runs
  send   name keys...        tmux send-keys names: Enter Escape C-c Tab Up
  type   name text           literal text
  say    name text [regex]   type text, Enter, then wait for regex
  cli    name args...        run scrap args (ls, read, send, attach) with the instance's config
  stream name id target      run scrap attach target in the background; stdin is
                             fed by stream-put, output kept under <dir>/streams/id
  stream-put  name id line   send a line to the stream's stdin
  stream-wait name id regex [secs]   until the stream output matches (default 10s)
  stream-cat  name id        print the stream output
  relay  name script         drive the instance's relay over WebSocket; script is a
                             JSON list of frames to send, seconds to sleep, and
                             {"wait": regex, "secs": n} steps that fail when no
                             received frame matches in time
  net    name                print the instance's tailscale ip and port
  broker name                print the pid of the instance's scrap hub broker
  joblog name job regex [secs]   until the job's log matches (default 20s)
  machine                    print this machine's tailnet name
  wait   name regex [secs]   until the screen matches (default 10s)
  idle   name [ms] [secs]    until the screen is unchanged for ms (default 500)
  snap   name [-e]           print the screen, instance dir as <rig>; -e keeps colour
  expect name golden [--update]   compare the screen to a golden file
  tab    name                print the highlighted session in the tab box
  log    name                scrap stderr
  dir    name                the instance directory
  stop   name
  ls
EOF
    exit 2
}

die() { echo "scraprig: $*" >&2; exit 1; }

tm() { env -u TMUX -u TMUX_PANE tmux -L "scraprig-$1" "${@:2}"; }

inst() {
    [ -n "${1:-}" ] || usage
    [ -d "$ROOT/$1" ] || die "no instance '$1'"
}

screen() { tm "$1" capture-pane -p -t rig "${@:2}"; }

snap() { screen "$@" | sed -e "s|/private$ROOT/$1|<rig>|g" -e "s|$ROOT/$1|<rig>|g" -e "s|^▌ scrap › [0-9]*\.[0-9]*+[0-9a-f]* › @[a-z0-9_-]*|▌ scrap › <version> › @<name>|"; }

dead() { [ "$(tm "$1" display -p -t rig '#{pane_dead}' 2>/dev/null || echo 1)" = 1 ]; }

fail_snap() {
    local name="$1"; shift
    echo "scraprig: $*" >&2
    screen "$name" >&2 || true
    if dead "$name"; then
        echo "scraprig: scrap exited ($(tm "$name" display -p -t rig '#{pane_dead_status}' 2>/dev/null || echo ?))" >&2
        tail -20 "$ROOT/$name/stderr" >&2 || true
    fi
    exit 1
}

cmd_start() {
    local name="" size="100x30" fake=0 openai=0 fixture="" share="" net=0 port="" scrap="$RIG_HOME/../../scrap"
    while [ $# -gt 0 ]; do
        case "$1" in
        -n) name="$2"; shift 2 ;;
        -s) size="$2"; shift 2 ;;
        --fake) fake=1; shift ;;
        --openai) openai=1; shift ;;
        --fixture) fixture="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"; fake=1; shift 2 ;;
        --share) share="$2"; shift 2 ;;
        --net) net=1; shift ;;
        --port) port="$2"; net=1; shift 2 ;;
        --scrap) scrap="$2"; shift 2 ;;
        --) shift; break ;;
        *) usage ;;
        esac
    done
    [ -x "$scrap" ] || die "no scrap binary at $scrap (run make)"
    scrap="$(cd "$(dirname "$scrap")" && pwd)/$(basename "$scrap")"
    mkdir -p "$ROOT"
    if [ -z "$name" ]; then
        local i=1
        while ! mkdir "$ROOT/r$i" 2>/dev/null; do i=$((i + 1)); done
        name="r$i"
    else
        mkdir "$ROOT/$name" 2>/dev/null || die "instance '$name' exists"
    fi
    local dir="$ROOT/$name"
    mkdir -p "$dir/state/config" "$dir/work" "$dir/bin"
    echo "$scrap" > "$dir/scrap"
    local conf="$dir/state/config"
    if [ -n "$share" ]; then
        mkdir -p "$share/live" "$share/dispatch" "$share/handoff" "$share/instances"
        touch "$share/chains"
        for leaf in live dispatch chains net handoff instances; do ln -s "$share/$leaf" "$conf/$leaf"; done
    fi
    if [ "$net" = 1 ] && { [ -n "$port" ] || [ ! -s "$conf/net" ]; }; then
        local ip
        ip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
        [ -n "$ip" ] || { rm -rf "$dir"; die "no tailscale address"; }
        printf 'port = %s\nbind = %s\n' "${port:-$((20000 + RANDOM % 20000))}" "$ip" > "$conf/net"
    elif [ "$net" = 0 ] && [ ! -s "$conf/net" ]; then
        echo 'broker = off' > "$conf/net"
    fi
    if [ "$openai" = 1 ]; then
        local i
        nohup "$RIG_HOME/fake-openai" "$dir/openai.port" >/dev/null 2>&1 &
        for ((i = 0; i < 50; i++)); do [ -s "$dir/openai.port" ] && break; sleep 0.1; done
        [ -s "$dir/openai.port" ] || { rm -rf "$dir"; die "fake-openai did not start"; }
        mkdir -p "$conf/agent"
        printf '{"default":"fake/echo","providers":{"fake":{"base_url":"http://127.0.0.1:%s/v1","list":false,"models":{"echo":{"context":20000}}}},"compactor_backend":"core","compactor_model":"fake/echo"}\n' \
            "$(cat "$dir/openai.port")" > "$conf/agent/providers.json"
    fi
    local path="$PATH"
    if [ "$fake" = 1 ]; then
        ln -s "$RIG_HOME/fake-claude" "$dir/bin/claude"
        ln -s "$RIG_HOME/fake-pvsay" "$dir/bin/pvsay"
        ln -s "$RIG_HOME/fake-jev" "$dir/bin/jev"
        ln -s "$scrap" "$dir/bin/scrap"
        path="$dir/bin:$PATH"
    fi
    local cmd
    cmd="$(printf '%q ' env "PATH=$path" "SCRAPRIG_FIXTURE=$fixture" \
        "$scrap" --state "$dir/state" "$@")2>$(printf '%q' "$dir/stderr")"
    tm "$name" -f /dev/null new-session -d -s rig -x "${size%x*}" -y "${size#*x}" \
        -c "$dir/work" "exec $cmd" \; \
        set -g status off \; set -g allow-passthrough on \; \
        set -g remain-on-exit on \; set -g window-size manual \
        || { rm -rf "$dir"; die "tmux failed to start"; }
    echo "$name"
}

cmd_wait() {
    local name="$1" re="$2" secs="${3:-10}"
    local end=$((SECONDS + secs))
    while [ $SECONDS -le $end ]; do
        screen "$name" | grep -Eq -- "$re" && return 0
        dead "$name" && fail_snap "$name" "scrap exited before /$re/"
        sleep 0.1
    done
    fail_snap "$name" "timed out after ${secs}s waiting for /$re/"
}

cmd_idle() {
    local name="$1" ms="${2:-500}" secs="${3:-10}"
    local end=$((SECONDS + secs)) last="" now stable=0
    while [ $SECONDS -le $end ]; do
        now="$(screen "$name")"
        if [ "$now" = "$last" ]; then
            stable=$((stable + 100))
            [ $stable -ge "$ms" ] && return 0
        else
            stable=0
            last="$now"
        fi
        sleep 0.1
    done
    fail_snap "$name" "screen still changing after ${secs}s"
}

cmd_expect() {
    local name="$1" golden="$2"
    if [ "${3:-}" = --update ]; then
        mkdir -p "$(dirname "$golden")"
        snap "$name" > "$golden"
        return 0
    fi
    [ -f "$golden" ] || die "no golden $golden (use --update)"
    snap "$name" | diff -u "$golden" - >&2 || fail_snap "$name" "screen differs from $golden"
}

cli_env() {
    local d="$ROOT/$1/state"
    printf '%q ' env "SCRAP_CONFIG_DIR=$d/config" "AGENT_TABS_STATE_DIR=$d/tabs" "TMPDIR=$d/tmp" \
        "$(cat "$ROOT/$1/scrap")"
}

cmd_stream() {
    local name="$1" id="$2" target="$3" d="$ROOT/$1/streams"
    mkdir -p "$d"
    [ ! -e "$d/$id.out" ] || die "stream '$id' exists"
    : > "$d/$id.in"
    : > "$d/$id.out"
    local cmd
    cmd="tail -f $(printf %q "$d/$id.in") | $(cli_env "$name")attach $(printf %q "$target") \
>$(printf %q "$d/$id.out") 2>&1; echo \$? > $(printf %q "$d/$id.exit")"
    tm "$name" new-window -d -n "stream-$id" "$cmd"
}

cmd_stream_wait() {
    local name="$1" id="$2" re="$3" secs="${4:-10}" d="$ROOT/$1/streams"
    [ -e "$d/$id.out" ] || die "no stream '$id'"
    local end=$((SECONDS + secs))
    while [ $SECONDS -le $end ]; do
        grep -Eq -- "$re" "$d/$id.out" && return 0
        if [ -e "$d/$id.exit" ]; then
            grep -Eq -- "$re" "$d/$id.out" && return 0
            echo "scraprig: stream '$id' exited ($(cat "$d/$id.exit")) before /$re/" >&2
            cat "$d/$id.out" >&2
            exit 1
        fi
        sleep 0.1
    done
    echo "scraprig: timed out after ${secs}s waiting for /$re/ on stream '$id'" >&2
    cat "$d/$id.out" >&2
    exit 1
}

cmd_broker() {
    local ip port
    read -r ip port < <("$0" net "$1")
    lsof -nP -iTCP@"$ip":"$port" -sTCP:LISTEN -Fp 2>/dev/null | sed -n 's/^p//p' | head -1 | grep . \
        || die "no broker on $ip:$port"
}

cmd_joblog() {
    local f="$ROOT/$1/state/config/jobs/log/$2.log" re="$3" secs="${4:-20}" i
    for ((i = 0; i < secs * 10; i++)); do
        grep -qE -- "$re" "$f" 2>/dev/null && return 0
        sleep 0.1
    done
    echo "scraprig: timed out after ${secs}s waiting for /$re/ in job log '$2'" >&2
    cat "$f" >&2 2>/dev/null || true
    exit 1
}

cmd_stop() {
    local name="$1" pid i
    pid="$(tm "$name" display -p -t rig '#{pane_pid}' 2>/dev/null || true)"
    tm "$name" kill-server 2>/dev/null || true
    if [ -n "$pid" ]; then
        for ((i = 0; i < 50; i++)); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -rf "${ROOT:?}/$name"
}

[ $# -gt 0 ] || usage
c="$1"; shift
case "$c" in
start) cmd_start "$@" ;;
say)
    inst "${1:-}"; [ $# -ge 2 ] || usage
    tm "$1" send-keys -t rig -l -- "$2"
    tm "$1" send-keys -t rig Enter
    [ -z "${3:-}" ] || cmd_wait "$1" "$3" "${4:-10}" ;;
cli)
    inst "${1:-}"
    d="$ROOT/$1/state"
    env "SCRAP_CONFIG_DIR=$d/config" "AGENT_TABS_STATE_DIR=$d/tabs" "TMPDIR=$d/tmp" \
        "$(cat "$ROOT/$1/scrap")" "${@:2}" ;;
stream) inst "${1:-}"; [ $# -eq 3 ] || usage; cmd_stream "$@" ;;
relay)
    inst "${1:-}"; [ $# -eq 2 ] || usage
    f="$ROOT/$1/state/config/relay"
    port=$(sed -n 's/^port *= *//p' "$f"); token=$(sed -n 's/^token *= *//p' "$f")
    uv run -q --with websockets python "$RIG_HOME/relayclient.py" "$port" "$token" "$2" ;;
stream-put)
    inst "${1:-}"; [ $# -eq 3 ] || usage
    [ -e "$ROOT/$1/streams/$2.in" ] || die "no stream '$2'"
    printf '%s\n' "$3" >> "$ROOT/$1/streams/$2.in" ;;
stream-wait) inst "${1:-}"; [ $# -ge 3 ] || usage; cmd_stream_wait "$@" ;;
stream-cat)
    inst "${1:-}"; [ $# -eq 2 ] || usage
    cat "$ROOT/$1/streams/$2.out" 2>/dev/null || die "no stream '$2'" ;;
broker) inst "${1:-}"; cmd_broker "$1" ;;
joblog) inst "${1:-}"; [ $# -ge 3 ] || usage; cmd_joblog "$@" ;;
net)
    inst "${1:-}"
    f="$ROOT/$1/state/config/net"
    [ -s "$f" ] || die "'$1' was not started with --net"
    echo "$(sed -n 's/^bind *= *//p' "$f") $(sed -n 's/^port *= *//p' "$f")" ;;
machine) tailscale status --json | python3 -c 'import json,sys;print(json.load(sys.stdin)["Self"]["DNSName"].split(".")[0])' ;;
send) inst "${1:-}"; tm "$1" send-keys -t rig "${@:2}" ;;
type) inst "${1:-}"; tm "$1" send-keys -t rig -l -- "${2:?text}" ;;
wait) inst "${1:-}"; [ $# -ge 2 ] || usage; cmd_wait "$@" ;;
idle) inst "${1:-}"; cmd_idle "$@" ;;
snap)
    inst "${1:-}"
    if [ "${2:-}" = -e ]; then snap "$1" -e; else snap "$1"; fi ;;
expect) inst "${1:-}"; [ $# -ge 2 ] || usage; cmd_expect "$@" ;;
tab)
    inst "${1:-}"
    screen "$1" -e | grep '│' | grep -oE $'\e\\[38;2;34;162;201m[^ \e]*@[a-z0-9_:.-]+' | head -1 | sed $'s/\e\\[[0-9;]*m//' ;;
log) inst "${1:-}"; cat "$ROOT/$1/stderr" ;;
dir) inst "${1:-}"; echo "$ROOT/$1" ;;
stop) inst "${1:-}"; cmd_stop "$1" ;;
ls) [ -d "$ROOT" ] && ls "$ROOT" || true ;;
*) usage ;;
esac
