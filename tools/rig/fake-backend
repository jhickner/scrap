#!/usr/bin/env python3
import json, os, select, subprocess, sys

backend = os.path.basename(sys.argv[0])
model, effort, system = 'default', 'default', ''
for option, dest in [('-m', 'model'), ('--reasoning-effort', 'effort')]:
    if option in sys.argv:
        globals()[dest] = sys.argv[sys.argv.index(option) + 1]

pending = b''


def next_line(timeout=None):
    global pending
    while b'\n' not in pending:
        if timeout is not None and not select.select([0], [], [], timeout)[0]:
            return None
        chunk = os.read(0, 65536)
        if not chunk:
            return ''
        pending += chunk
    line, pending = pending.split(b'\n', 1)
    return line.decode() + '\n'


def emit(value):
    print(json.dumps(value), flush=True)


def log(msg):
    with open('backend-protocol.jsonl', 'a') as f:
        f.write(json.dumps({'backend': backend, 'message': msg}) + '\n')


def quota():
    try:
        return json.load(open('backend-quota.json')).get(backend)
    except (OSError, ValueError):
        return None


def steer(msg, active):
    params = msg.get('params') or {}
    text = ''.join(i.get('text', '') for i in params.get('input', []))
    if not active:
        emit({'id': msg['id'], 'error': {'code': -32600, 'message': 'no active turn to steer'}})
        return None
    if params.get('expectedTurnId') != 'fake-turn':
        emit({'id': msg['id'], 'error': {'code': -32600, 'message': 'expected active turn id `%s` but found `fake-turn`' % params.get('expectedTurnId')}})
        return None
    if 'notsteerable' in text:
        emit({'id': msg['id'], 'error': {'code': -32600, 'message': 'cannot steer a compact turn',
              'data': {'codexErrorInfo': {'activeTurnNotSteerable': {'turnKind': 'compact'}}}}})
        return None
    emit({'id': msg['id'], 'result': {'turnId': 'fake-turn'}})
    return (params.get('clientUserMessageId'), text)


def codex_run(msg, cmd, done):
    emit({'id': msg['id'], 'result': {'turn': {'id': 'fake-turn'}}})
    item = {'type': 'commandExecution', 'id': 'exec-1', 'command': cmd, 'status': 'inProgress'}
    emit({'method': 'item/started', 'params': {'threadId': 'fake-codex', 'turnId': 'fake-turn', 'item': item}})
    proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    queued = []
    while proc.poll() is None:
        line = next_line(0.1)
        if line is None:
            continue
        if not line:
            proc.kill()
            return
        m = json.loads(line)
        log(m)
        if m.get('method') == 'turn/steer':
            got = steer(m, True)
            if got:
                queued.append(got)
        elif m.get('method') == 'turn/interrupt':
            proc.kill()
            emit({'id': m['id'], 'result': {}})
            emit({'method': 'turn/completed', 'params': {'threadId': 'fake-codex', 'turn': {'id': 'fake-turn', 'status': 'interrupted'}}})
            return
        elif 'id' in m:
            emit({'id': m['id'], 'result': {}})
    out = proc.stdout.read().strip()
    item = dict(item, status='completed', aggregatedOutput=out)
    emit({'method': 'item/completed', 'params': {'threadId': 'fake-codex', 'turnId': 'fake-turn', 'item': item}})
    for cid, text in queued:
        user = {'type': 'userMessage', 'id': 'um-' + str(cid), 'clientId': cid,
                'content': [{'type': 'text', 'text': text}]}
        emit({'method': 'item/started', 'params': {'threadId': 'fake-codex', 'turnId': 'fake-turn', 'item': user}})
        emit({'method': 'item/completed', 'params': {'threadId': 'fake-codex', 'turnId': 'fake-turn', 'item': user}})
    reply = 'steered: ' + ' | '.join(t for _, t in queued) if queued else done(out)
    emit({'method': 'item/agentMessage/delta', 'params': {'threadId': 'fake-codex', 'turnId': 'fake-turn', 'delta': reply}})
    emit({'method': 'turn/completed', 'params': {'threadId': 'fake-codex', 'turn': {'id': 'fake-turn', 'status': 'completed'}}})


def gk_update(u):
    emit({'jsonrpc': '2.0', 'method': 'session/update', 'params': {'sessionId': 'fake-grok', 'update': u}})


def grok_run(msg, cmd, done):
    tool = {'toolCallId': 'call-1', 'title': 'run_terminal_command', 'rawInput': {'command': cmd},
            '_meta': {'x.ai/tool': {'name': 'run_terminal_command', 'kind': 'execute'}}}
    gk_update(dict(tool, sessionUpdate='tool_call'))
    gk_update({'sessionUpdate': 'tool_call_update', 'toolCallId': 'call-1', 'status': 'in_progress'})
    proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    queued = []
    while proc.poll() is None:
        line = next_line(0.1)
        if line is None:
            continue
        if not line:
            proc.kill()
            return
        m = json.loads(line)
        log(m)
        p = m.get('params') or {}
        if m.get('method') == '_x.ai/interject':
            if 'notsteerable' in p.get('text', ''):
                emit({'jsonrpc': '2.0', 'id': m['id'], 'error': {'code': -32603, 'message': 'cannot interject'}})
                continue
            emit({'jsonrpc': '2.0', 'id': m['id'], 'result': {'result': {'status': 'queued'}}})
            emit({'jsonrpc': '2.0', 'method': '_x.ai/session/interjection',
                  'params': {'sessionId': 'fake-grok', 'text': p.get('text'), 'interjectionId': p.get('interjectionId')}})
            queued.append(p.get('text'))
        elif m.get('method') == 'session/cancel':
            proc.kill()
            emit({'jsonrpc': '2.0', 'id': msg['id'], 'result': {'stopReason': 'cancelled'}})
            return
        elif 'id' in m:
            emit({'jsonrpc': '2.0', 'id': m['id'], 'result': {}})
    out = proc.stdout.read().strip()
    gk_update({'sessionUpdate': 'tool_call_update', 'toolCallId': 'call-1', 'status': 'completed',
               'content': [{'type': 'content', 'content': {'type': 'text', 'text': out}}]})
    reply = 'steered: ' + ' | '.join(queued) if queued else done(out)
    gk_update({'sessionUpdate': 'agent_message_chunk', 'content': {'type': 'text', 'text': reply}})
    emit({'jsonrpc': '2.0', 'id': msg['id'], 'result': {'stopReason': 'end_turn'}})


if quota() == 'fail':
    sys.exit(1)
while True:
    line = next_line()
    if not line:
        break
    msg = json.loads(line)
    log(msg)
    method, params = msg.get('method'), msg.get('params') or {}
    result = {}
    if method == 'account/rateLimits/read':
        used = quota()
        result = {'rateLimits': {'primary': {'usedPercent': used, 'resetsAt': 2000000000}}} if isinstance(used, int) else {}
    elif method == '_x.ai/billing':
        used = quota()
        result = {'config': {'creditUsagePercent': used, 'billingPeriodEnd': '2033-05-18T03:33:20Z'}} if isinstance(used, int) else {}
    elif method in ('thread/start', 'thread/resume'):
        model = params.get('model', model)
        system = params.get('developerInstructions', '')
        result = {'thread': {'id': 'fake-codex'}}
    elif method in ('session/new', 'session/resume'):
        result = {'sessionId': 'fake-grok'}
    elif method == 'session/set_model':
        model = params['modelId']
    elif method == 'session/set_mode':
        effort = params['modeId']
    elif method == 'turn/steer':
        steer(msg, False)
        continue
    elif method == '_x.ai/interject':
        emit({'jsonrpc': '2.0', 'id': msg['id'], 'error': {'code': -32603, 'message': 'interject while idle'}})
        continue
    elif method in ('turn/start', 'session/prompt'):
        inputs = params.get('input', params.get('prompt', []))
        text = ''.join(i.get('text', '') for i in inputs)
        effort = params.get('effort', effort)
        prompt = text if backend == 'codex' else text.split('\n')[-1]
        if prompt.startswith('quota-error'):
            error = {'message': "You've hit your usage limit", 'codexErrorInfo': 'usageLimitExceeded'}
            if backend == 'codex':
                emit({'id': msg['id'], 'result': {'turn': {'id': 'fake-turn'}}})
                emit({'method': 'turn/completed', 'params': {'threadId': 'fake-codex', 'turn': {'id': 'fake-turn', 'status': 'failed', 'error': error}}})
            else:
                emit({'jsonrpc': '2.0', 'id': msg['id'], 'error': error})
            continue
        if backend == 'codex' and prompt.startswith('run: '):
            codex_run(msg, prompt[5:], lambda out: 'ran: ' + out)
            continue
        if backend == 'codex' and prompt.startswith('slow: '):
            secs, said = prompt[6:].split(' ', 1)
            codex_run(msg, 'sleep ' + secs, lambda out, said=said: 'slowdone: ' + said)
            continue
        if backend == 'grok' and prompt.startswith('run: '):
            grok_run(msg, prompt[5:], lambda out: 'ran: ' + out)
            continue
        history = system if backend == 'codex' else text
        reply = '%s: %s (%s, %s) history=%s' % (backend, prompt, model, effort, 'kept' if 'history-marker' in history else 'empty')
        if backend == 'codex':
            emit({'id': msg['id'], 'result': {'turn': {'id': 'fake-turn'}}})
            emit({'method': 'item/agentMessage/delta', 'params': {'threadId': 'fake-codex', 'turnId': 'fake-turn', 'delta': reply}})
            emit({'method': 'turn/completed', 'params': {'threadId': 'fake-codex', 'turn': {'id': 'fake-turn', 'status': 'completed'}}})
        else:
            emit({'jsonrpc': '2.0', 'method': 'session/update', 'params': {'sessionId': 'fake-grok', 'update': {'sessionUpdate': 'agent_message_chunk', 'content': {'type': 'text', 'text': reply}}}})
            emit({'jsonrpc': '2.0', 'id': msg['id'], 'result': {'stopReason': 'end_turn'}})
        continue
    if 'id' in msg:
        emit({'jsonrpc': '2.0', 'id': msg['id'], 'result': result})
