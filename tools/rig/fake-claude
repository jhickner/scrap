#!/usr/bin/env python3
import json, os, re, select, subprocess, sys, time, uuid

SESSION = "fake-%d" % os.getpid()
NOTES = 0
CHAIN = 0
MODEL = "fake"


def emit(ev):
    ev.setdefault("session_id", SESSION)
    sys.stdout.write(json.dumps(ev) + "\n")
    sys.stdout.flush()


def record(role, text):
    if not os.environ.get("SCRAPRIG_TRANSCRIPTS"):
        return
    cwd = os.path.realpath(os.getcwd())
    folder = "".join(c if c.isalnum() else "-" for c in cwd)
    root = os.path.join(os.environ["HOME"], ".claude", "projects", folder)
    os.makedirs(root, exist_ok=True)
    with open(os.path.join(root, SESSION + ".jsonl"), "a") as f:
        f.write(json.dumps({"type": role, "sessionId": SESSION,
                            "message": {"role": role, "content": text}}) + "\n")


def load_turns():
    path = os.environ.get("SCRAPRIG_FIXTURE")
    if not path:
        return []
    turns, cur = [], []
    for line in open(path):
        line = line.strip()
        if line == "---":
            turns.append(cur)
            cur = []
        elif line:
            cur.append(json.loads(line))
    if cur:
        turns.append(cur)
    return turns


def prompt_text(msg):
    content = msg.get("message", {}).get("content", "")
    if isinstance(content, str):
        return content
    return "".join(b.get("text", "") for b in content if b.get("type") == "text")


def run(cmd):
    proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True)
    while proc.poll() is None:
        if not select.select([sys.stdin], [], [], 0.1)[0]:
            continue
        line = sys.stdin.readline()
        if not line:
            proc.wait()
            break
        msg = json.loads(line)
        if msg.get("request", {}).get("subtype") == "interrupt":
            proc.kill()
            emit({"type": "control_response", "response": {
                "subtype": "success", "request_id": msg.get("request_id"), "response": {}}})
            return "interrupted: " + cmd
    return "ran: " + proc.stdout.read().strip()


def main():
    global SESSION, NOTES, CHAIN
    turns = load_turns()
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        kind = msg.get("type")
        if kind == "control_request":
            emit({"type": "control_response", "response": {
                "subtype": "success", "request_id": msg.get("request_id"),
                "response": {}}})
        elif kind == "user":
            text = prompt_text(msg)
            emit({"type": "system", "subtype": "init", "model": MODEL,
                  "cwd": os.getcwd(), "apiKeySource": "none"})
            if text == "/clear":
                SESSION = "fake-%s" % uuid.uuid4().hex[:8]
                emit({"type": "result", "subtype": "success", "is_error": False,
                      "duration_ms": 1, "num_turns": 0, "total_cost_usd": 0,
                      "usage": {"input_tokens": 0, "output_tokens": 0}})
                continue
            record("user", text)
            if text.startswith("ask: "):
                if "--permission-prompt-tool" not in sys.argv:
                    text = "denied: no permission prompt tool"
                else:
                    emit({"type": "control_request", "request_id": "perm-1", "request": {
                        "subtype": "can_use_tool", "tool_name": "Bash",
                        "input": {"command": text[5:]}, "description": "run a command"}})
                    reply = json.loads(sys.stdin.readline())
                    behavior = reply["response"]["response"]["behavior"]
                    text = ("allowed: " if behavior == "allow" else "denied: ") + text[5:]
            elif text.startswith("tool: "):
                cmd = text[6:]
                ran = subprocess.run(cmd, shell=True, capture_output=True, text=True)
                emit({"type": "assistant", "message": {"role": "assistant", "model": MODEL, "content": [
                    {"type": "tool_use", "id": "tu-1", "name": "Bash", "input": {"command": cmd}}]}})
                emit({"type": "user", "message": {"role": "user", "content": [
                    {"type": "tool_result", "tool_use_id": "tu-1",
                     "content": (ran.stdout + ran.stderr).strip()}]}})
                text = "tool done"
            elif "auto-handoff threshold" in text:
                path = re.search(r"Save it to (\S+), make no other changes", text).group(1)
                NOTES += 1
                with open(path, "w") as f:
                    f.write("note %d%s%s" % (NOTES, " interrupted" if "interrupted" in text else "",
                                             " ctx: %d chain" % CHAIN if CHAIN else ""))
                text = "saved\n@handoff " + path
            elif re.search(r"\bctx: \d+", text):
                used = int(re.search(r"\bctx: (\d+)", text).group(1))
                CHAIN = used if "chain" in text else 0
                emit({"type": "assistant", "message": {"role": "assistant", "model": MODEL,
                      "usage": {"input_tokens": used, "output_tokens": 0},
                      "content": [{"type": "text", "text": "working at %d" % used}]}})
                time.sleep(1.5)
                emit({"type": "result", "subtype": "success", "is_error": False,
                      "duration_ms": 1, "num_turns": 1, "total_cost_usd": 0,
                      "usage": {"input_tokens": used, "output_tokens": 0},
                      "modelUsage": {MODEL: {"contextWindow": 1000}},
                      "result": "ctx %d" % used})
                continue
            elif text == "askme":
                text = "Pick one.\n\n@ask\n1. Color?\n- red\n- blue"
            elif text.startswith("run: "):
                text = run(text[5:])
            else:
                text = "echo: " + text
            canned = bool(turns)
            events = turns.pop(0) if turns else [{
                "type": "assistant",
                "message": {"role": "assistant", "model": MODEL, "content": [
                    {"type": "text", "text": text}]}}]
            for ev in events:
                emit(ev)
            record("assistant", text)
            result = {"type": "result", "subtype": "success", "is_error": False,
                      "duration_ms": 1, "num_turns": 1, "total_cost_usd": 0,
                      "usage": {"input_tokens": 1, "output_tokens": 1}}
            if not canned:
                result["result"] = text
            emit(result)


if __name__ == "__main__":
    main()
